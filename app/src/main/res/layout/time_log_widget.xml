    <LinearLayout android:id="@+id/widget_button_6" style="@style/WidgetLogCell"
        android:orientation="vertical" android:gravity="center" android:contentDescription="라이프 이벤트 기록">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
