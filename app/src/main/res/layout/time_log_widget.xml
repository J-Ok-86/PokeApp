<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:orientation="vertical"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background" android:padding="9dp">
  <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:paddingBottom="4dp" android:text="🕒 PokeHabit · 라이프 이벤트"
      android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp"/>
  <LinearLayout android:id="@+id/widget_row_1" android:layout_width="match_parent"
      android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
    <LinearLayout android:id="@+id/widget_button_1" style="@style/WidgetLogCell"
        android:orientation="vertical" android:gravity="center" android:contentDescription="라이프 이벤트 기록">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_emoji_1" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textSize="22sp" android:includeFontPadding="false" android:maxLines="1" android:text="📌" />
        <TextView android:id="@+id/widget_count_1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/widget_count_background" android:paddingLeft="4dp" android:paddingRight="4dp"
            android:paddingTop="1dp" android:paddingBottom="1dp" android:textSize="12sp" android:includeFontPadding="false" android:textStyle="bold"
            android:textColor="#E9F5FF" android:singleLine="true" android:text="0회" />
      </LinearLayout>
      <TextView android:id="@+id/widget_name_1" android:layout_width="match_parent" android:layout_height="wrap_content"
          android:textSize="15sp" android:includeFontPadding="false" android:textStyle="bold" android:layout_marginTop="1dp" android:textColor="#FFFFFF"
          android:ellipsize="end" android:singleLine="true" android:text="라이프 이벤트"/>
      <TextView android:id="@+id/widget_time_1" android:layout_width="match_parent" android:layout_height="wrap_content"
          android:textSize="16sp" android:includeFontPadding="false" android:textStyle="bold" android:layout_marginTop="1dp" android:textColor="#CDEFE8"
          android:singleLine="true" android:text="＋ 기록"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_button_2" style="@style/WidgetLogCell"
        android:orientation="vertical" android:gravity="center" android:contentDescription="라이프 이벤트 기록">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_emoji_2" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textSize="22sp" android:includeFontPadding="false" android:maxLines="1" android:text="📌" />
        <TextView android:id="@+id/widget_count_2" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/widget_count_background" android:paddingLeft="4dp" android:paddingRight="4dp"
            android:paddingTop="1dp" android:paddingBottom="1dp" android:textSize="12sp" android:includeFontPadding="false" android:textStyle="bold"
            android:textColor="#E9F5FF" android:singleLine="true" android:text="0회" />
      </LinearLayout>
      <TextView android:id="@+id/widget_name_2" android:layout_width="match_parent" android:layout_height="wrap_content"
          android:textSize="15sp" android:includeFontPadding="false" android:textStyle="bold" android:layout_marginTop="1dp" android:textColor="#FFFFFF"
          android:ellipsize="end" android:singleLine="true" android:text="라이프 이벤트"/>
      <TextView android:id="@+id/widget_time_2" android:layout_width="match_parent" android:layout_height="wrap_content"
          android:textSize="16sp" android:includeFontPadding="false" android:textStyle="bold" android:layout_marginTop="1dp" android:textColor="#CDEFE8"
          android:singleLine="true" android:text="＋ 기록"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_button_3" style="@style/WidgetLogCell"
        android:orientation="vertical" android:gravity="center" android:contentDescription="라이프 이벤트 기록">
