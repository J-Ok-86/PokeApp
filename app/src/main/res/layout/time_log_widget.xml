  </LinearLayout>
  <TextView android:id="@+id/widget_last" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:paddingTop="3dp" android:text="앱을 열면 기록 시간이 동기화됩니다"
      android:textColor="#D4E8F5" android:textSize="11sp" android:singleLine="true" android:ellipsize="end" />
