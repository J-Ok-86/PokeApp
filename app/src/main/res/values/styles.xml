<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#f9fcff</item>
        <item name="android:navigationBarColor">#f9fcff</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
<style name="WidgetLogButton">
  <item name="android:layout_width">0dp</item>
  <item name="android:layout_height">54dp</item>
  <item name="android:layout_weight">1</item>
  <item name="android:layout_marginEnd">3dp</item>
  <item name="android:layout_marginStart">3dp</item>
  <item name="android:gravity">center</item>
  <item name="android:padding">4dp</item>
  <item name="android:background">@drawable/widget_button</item>
  <item name="android:textColor">#FFFFFF</item>
  <item name="android:textSize">12sp</item>
  <item name="android:maxLines">2</item>
 </style>
</resources>
